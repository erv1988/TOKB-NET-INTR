# Answerfile для setup-alpine (Alpine Linux 3.24) — учебный стенд ТОКБ.
# Запуск установки:
#     setup-alpine -e -f http://10.0.2.2:8008/build/answerfile
#   -e          пустой пароль root (пароли задаются потом в provision.sh)
#   -f http://  setup-alpine САМ скачает этот файл и выполнит его как shell-скрипт
#
# ВАЖНО: установка НЕ должна запускаться из песочницы/ограниченного окружения.
# Если процесс VirtualBox не имеет доступа к сети хоста, DHCP внутри NAT работает,
# но guest->10.0.2.2 и наружу не ходит (setup-alpine упадёт на скачивании файла).
#
# Семантика переменных сверена с исходником /usr/sbin/setup-alpine
# из пакета alpine-conf-3.22.0-r0 (Alpine 3.24).

# --- Клавиатура и имя ------------------------------------------------------
KEYMAPOPTS="us us"              # US-раскладка (важно: команды набираются в консоли)
HOSTNAMEOPTS="alpine-tokb"      # имя по умолчанию; на стенде меняется в этапе 0

# --- Сеть ------------------------------------------------------------------
# На время установки и провизонирования — DHCP (в VirtualBox NIC = NAT, есть интернет).
# Статические адреса стенда (192.168.56.10 — жертва, .20 — атакующий)
# задаются в этапе 0, когда адаптер уже переключён в режим «Виртуальный адаптер хоста».
INTERFACESOPTS="auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp
"

# --- Прочее ----------------------------------------------------------------
DEVDOPTS="mdev"                 # менеджер устройств (по умолчанию в Alpine)
TIMEZONEOPTS="UTC"              # часы стенда — в UTC (важно единообразие в дампах)
PROXYOPTS="none"                # прокси не используем
APKREPOSOPTS="-1"               # первый зеркало (CDN) без вопроса про выбор зеркала
NTPOPTS="none"                  # синхронизация времени не нужна
SSHDOPTS="openssh"              # ssh из коробки (удобно передавать файлы с хоста)

# Учебный пользователь student: -a = админ (wheel + doas), -u = разблокировать
# без запроса пароля. ВАЖНО (найдено в исходнике setup-sshd): если в системе
# уже есть обычный пользователь, установщик НЕ спрашивает про SSH-логин root,
# иначе установка остановилась бы на этом вопросе.
USEROPTS="-a -u -g audio,input,video,netdev student"
ROOTSSHKEY="none"               # ключи не нужны, логин root — по паролю

# --- Установка на диск -----------------------------------------------------
DISKOPTS="-m sys /dev/sda"      # полная система на /dev/sda (SATA-диск ВМ)
LBUOPTS="none"                  # режим lbu (diskless) не используем
APKCACHEOPTS="none"             # локальный кэш пакетов не нужен

# ERASE_DISKS подавляет интерактивный вопрос setup-disk
# "WARNING: Erase the above disk(s) and continue? (y/n)" — иначе установка встанет
# и будет ждать 'y'. Проверено по исходнику setup-disk: confirm_erase() возвращает
# успех сразу, если $ERASE_DISKS совпадает со списком дисков.
# export ОБЯЗАТЕЛЕН: setup-disk запускается как дочерний процесс и видит только
# унаследованное окружение, а answerfile всего лишь «подключается» через '.'.
export ERASE_DISKS="/dev/sda"
