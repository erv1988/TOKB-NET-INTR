# ===========================================================================
#  lab.rules — собственные правила Snort для лабораторной работы.
#  Подключается строкой include из snort_lab.conf.
#
#  Структура правила:
#     действие протокол ИСТОЧНИК порт -> НАЗНАЧЕНИЕ порт ( опции; )
#     действие: alert — предупредить, drop — заблокировать (только в inline!),
#               log — только записать.
#
#  ВАЖНО:
#   1) в каждом правиле обязателен sid (иначе правило не загрузится),
#      а для правок правила принято увеличивать rev;
#   2) classtype должен быть ОБЪЯВЛЕН в конфиге (мы объявляем свои классы
#      lab-recon / lab-dos / lab-info в snort_lab.conf) — ссылка на
#      несуществующий класс не даст правилу загрузиться;
#   3) после любой правки проверяйте: sudo snort -T -c /etc/snort/lab.conf
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Сканирование портов: много «чистых» SYN от одного источника за секунды.
#    Под наш syn_scan.py / nmap -sS.
#
#    detection_filter — НЕ «алертить на каждый пакет», а включить источник
#    в наблюдение: правило срабатывает, начиная с пакета, который ПРЕВЫСИЛ
#    порог (count+1-й подходящий пакет в окне seconds), и далее алертит на
#    каждый следующий подходящий пакет, пока тот укладывается в окно.
#    Смысл: один скан не должен породить сотни одинаковых алертов.
#    Порог подбирается экспериментально (этап 5).
#    (Сравните с mini_ids.py: там счётчик обнуляется и выдаётся РОВНО ОДИН
#     алерт на «всплеск» — это другая, более грубая политика.)
# ---------------------------------------------------------------------------
alert tcp $EXTERNAL_NET any -> $HOME_NET any ( \
    msg:"LAB SCAN: возможное SYN-сканирование портов"; \
    flags:S; \
    detection_filter: track by_src, count 30, seconds 2; \
    classtype:lab-recon; \
    sid:1000001; rev:1; )

# ---------------------------------------------------------------------------
# 2. SYN-флуд на конкретный сервис: лавина SYN на один порт.
#    Отличие от правила 1 — порог выше и указан конкретный порт сервиса.
#    Расход: посмотрите, на каком по счёту пакете появляется алерт
#    (в отчёте нужно объяснить, что порог — это компромисс между
#    ложными срабатываниями и пропуском атаки).
# ---------------------------------------------------------------------------
alert tcp $EXTERNAL_NET any -> $HOME_NET 8080 ( \
    msg:"LAB DOS: SYN-флуд на учебный сервис 8080"; \
    flags:S; \
    detection_filter: track by_src, count 100, seconds 2; \
    classtype:lab-dos; \
    sid:1000002; rev:1; )

# ---------------------------------------------------------------------------
# 3. Правило-«детектор шума»: обращение к сервису с установленного соединения
#    (пример использования flow — то, чего не умеет правило без состояния).
#    Служит для сравнения: такие правила работают только при включённом
#    препроцессоре stream5 (см. snort_lab.conf).
#    Наш banner_grab.py посылает строку "hello" — она и служит признаком.
# ---------------------------------------------------------------------------
alert tcp $EXTERNAL_NET any -> $HOME_NET 8080 ( \
    msg:"LAB INFO: обращение к учебному сервису (established)"; \
    flow:to_server,established; \
    content:"hello"; \
    classtype:lab-info; \
    sid:1000003; rev:1; )

# ---------------------------------------------------------------------------
# 4. (ЗАГОТОВКА ДЛЯ ВАРИАНТА) ICMP-флуд: много echo-request от одного источника.
#    Раскомментируйте и подберите порог.
# ---------------------------------------------------------------------------
# alert icmp $EXTERNAL_NET any -> $HOME_NET any ( \
#     msg:"LAB DOS: ICMP-флуд (ping flood)"; \
#     itype:8; \
#     detection_filter: track by_src, count 100, seconds 2; \
#     classtype:lab-dos; \
#     sid:1000004; rev:1; )

# ---------------------------------------------------------------------------
# 5. (ЗАГОТОВКА ДЛЯ ВАРИАНТА) Правило с действием DROP.
#    Помните: в пассивном режиме (IDS) drop физически ничего не блокирует —
#    Snort понижает его до alert. Роняет пакеты только inline-режим
#    (snort -Q --daq nfq), см. этап 8.
# ---------------------------------------------------------------------------
# drop tcp $EXTERNAL_NET any -> $HOME_NET 8080 ( \
#     msg:"LAB IPS: SYN-флуд заблокирован"; \
#     flags:S; \
#     detection_filter: track by_src, count 100, seconds 2; \
#     classtype:lab-dos; \
#     sid:1000010; rev:1; )
